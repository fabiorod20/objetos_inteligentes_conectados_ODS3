  {
    "id": "fn_alertas",
    "type": "function",
    "z": "tab_velocidade",
    "name": "Registra alerta (últimos 10)",
    "func": "const d = msg.payload;\nif (typeof d !== 'object') return null;\n\nconst hora = new Date().toLocaleTimeString('pt-BR', { timeZone: 'America/Sao_Paulo' });\nconst lista = flow.get('alertas') || [];\nlista.unshift({ 'Hora': hora, 'Velocidade (km/h)': d.velocidade, 'Excesso (%)': d.percentual_excesso });\nflow.set('alertas', lista.slice(0, 10));\n\nreturn [\n    { payload: lista.slice(0, 10) },                                                          // tabela\n    { payload: 'ALERTA CRÍTICO: ' + d.velocidade + ' km/h (' + d.percentual_excesso + '% acima do limite)' } // pop-up\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 300,
    "wires": [["ui_tabela"], ["ui_popup"]]
  },
